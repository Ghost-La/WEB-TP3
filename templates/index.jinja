{% extends "base.jinja" %}

{% block title %}Accueil{% endblock %}

{% block content %}
<h1 class="mb-4 page-title">Dernières cartes ajoutées</h1>

<div class="position-relative mb-4 col-md-6">
    <form id="form-recherche-accueil" method="get" action="{{ url_for('index') }}">
        <div class="input-group">
            <input type="text" id="recherche-accueil" name="q" class="form-control"
                placeholder="Rechercher une carte (min. 2 caractères)..." autocomplete="off"
                value="{{ request.args.get('q', '') }}">
            <button class="btn btn-primary" type="submit">Rechercher</button>
        </div>
        <div id="suggestions-accueil" class="list-group position-absolute w-100 d-none"
            style="z-index: 1050; max-height: 280px; overflow-y: auto;"></div>
    </form>
</div>

{% if "id" in session %}
<div class="mb-3">
    <a href="{{ url_for('index', filtre='disponibles') }}"
        class="btn btn-sm {% if filtre != 'recherchees' %}btn-primary{% else %}btn-outline-primary{% endif %}">
        Disponibles
    </a>
    <a href="{{ url_for('index', filtre='recherchees') }}"
        class="btn btn-sm {% if filtre == 'recherchees' %}btn-primary{% else %}btn-outline-primary{% endif %}">
        Recherchées
    </a>
</div>
{% endif %}

<div id="liste-cartes" class="row g-4"></div>

<div id="loader-cartes" class="text-center my-4 d-none">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Chargement...</span>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    document.addEventListener("DOMContentLoaded", () => {
        initialiserBarreRecherche(
            "recherche-accueil",
            "suggestions-accueil",
            "form-recherche-accueil"
        );

        const chargeur = new ChargeurCartes({
            conteneurId: "liste-cartes",
            loaderId: "loader-cartes",
            filtre: "{{ filtre or '' }}",
            recherche: "{{ request.args.get('q', '') }}",
            estCollection: false
        });

        chargeur.charger(true);
        chargeur.activerInfiniteScroll();
        chargeur.demarrerPolling(5000);
    });
</script>
{% endblock %}