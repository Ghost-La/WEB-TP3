<!DOCTYPE html>
<html lang="{{ locale|default('fr_CA') }}">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="{{ url_for('static', filename='css/styles.css') }}">

    <title>
        {% block title %}MonPokedex{% endblock %}
        | MonPokedex
    </title>
</head>


<body class="bg-light">

    <header class="entete-site">

        <div class="container py-3">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <a href="{{ url_for('index') }}" class="d-flex align-items-center text-decoration-none">

                    <img src="{{ url_for('static',
                        filename='image/logo.svg') }}" alt="Logo Pokémon" class="me-2" style="height:50px;">

                    <span class="fs-4 fw-bold text-dark">
                        MonPokedex
                    </span>

                </a>

                <nav class="nav-principale gap-3">
                    <ul class="nav gap-3">

                        <li class="nav-item">
                            <a class="nav-link" href="{{ url_for('index') }}">
                                Accueil
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="{{ url_for('collection.recherche') }}">
                                Rechercher
                            </a>
                        </li>

                        {% if "id" in session %}

                        <li class="nav-item">
                            <a class="nav-link" href="{{ url_for('collection.collection') }}">
                                Ma collection
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="{{ url_for('collection.liste_offres') }}">Offres</a>
                        </li>

                        {% if session.get('role') == 'admin' %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ url_for('comptes.liste_utilisateurs') }}">
                                Utilisateurs
                            </a>
                        </li>
                        {% endif %}

                        <li class="nav-item">
                            <a class="nav-link" href="{{ url_for('comptes.deconnexion') }}">
                                Déconnexion ({{ session.courriel }})
                            </a>
                        </li>

                        {% else %}

                        <li class="nav-item">
                            <a class="nav-link" href="{{ url_for('comptes.connexion') }}">
                                Connexion
                            </a>
                        </li>

                        {% endif %}

                    </ul>
                </nav>
            </div>
        </div>
    </header>

    <main class="container py-4">
        {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
        {% for categorie, message in messages %}
        <div class="alert alert-{{ categorie }} alert-dismissible fade show" role="alert">
            {{ message }}
        </div>
        {% endfor %}
        {% endif %}
        {% endwith %}

        {% block content %}
        {% endblock %}

    </main>

    <footer class="bg-dark text-white text-center py-3 mt-5">

        <p class="mb-0">
            © 2026 - Océane Mboué et Frank Moyo
        </p>

        {% if "id" in session %}

        <small>
            Connecté : {{ session["courriel"] }}
        </small>

        {% endif %}

    </footer>
    <script src="{{ url_for('static', filename='js/ajax.js') }}"></script>
    {% block scripts %}
    {% endblock %}

</body>

</html>