{% extends "base.jinja" %}

{% block title %}Liste des utilisateurs{% endblock %}

{% block content %}
<h1 class="mb-4">Utilisateurs</h1>

<a href="{{ url_for('comptes.ajouter_utilisateur') }}" class="btn btn-primary mb-3">
    Ajouter un utilisateur
</a>

<table class="table table-striped" id="table-utilisateurs">
    <thead>
        <tr>
            <th>ID</th>
            <th>Courriel</th>
            <th>Crédit</th>
            <th>Rôle</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for u in utilisateurs %}
        <tr data-id="{{ u.id }}">
            <td>{{ u.id }}</td>
            <td>{{ u.courriel }}</td>
            <td>{{ u.credit }}</td>
            <td>{{ u.role }}</td>
            <td>
                {% if u.id != session.id %}
                <button type="button" class="btn btn-sm btn-danger"
                    onclick="supprimerUtilisateur({{ u.id }}, this.closest('tr'))">
                    Supprimer
                </button>
                {% else %}
                <span class="text-muted">-</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}