{% extends "base.jinja" %}

{% block title %}Recherche{% endblock %}

{% block content %}

<h1 class="mb-4 page-title">
    Rechercher une carte Pokémon
</h1>


<form method="POST" action="{{ url_for('collection.recherche') }}" class="mb-5" novalidate="novalidate">

    <div class="mb-3">
        <label class="form-label" for="nom">
            Nom de la carte
        </label>



        <input type="search" name="nom" id="nom" id="recherche" class="form-control" placeholder="Rechercher une carte"
            {% if erreur and not cartes %}is-invalid{% endif %}>
        
        <div id="suggestions" class="list-group mt-2">
        </div>

    </div>

    {% if erreur %}
    <div class="invalid-feedback d-block">
        {{ erreur }}
    </div>
    {% endif %}
    </div>

    <button type="submit" class="btn btn-primary">
        Rechercher
    </button>

</form>

{% if cartes %}

<div class="row row-cols-1 row-cols-md-3 g-4 mt-4">

    {% for carte in cartes %}

    <div class="col">
        <div class="card shadow-sm h-100">

            <div class="card-body d-flex flex-column">

                <h5 class="card-title">
                    {{ carte.nom }}
                </h5>

                <p class="card-text">
                    <strong>Type :</strong>
                    {{ carte.supertype }}

                    <br>

                    <strong>Rareté :</strong>
                    {{ carte.rarete }}
                </p>

                <a href="{{ url_for('api.ajout_envie',id_carte=carte.id) }}" class="btn btn-success btn-sm">

                    Ajouter aux envies

                </a>

                {% if "id" in session %}
                <a href="{{ url_for('collection.ajout_carte',id_carte=carte.id) }}" class="btn btn-success btn-sm">

                    Ajouter à la collection

                </a>

                {% endif %}

            </div>

        </div>
    </div>

    {% endfor %}

</div>

{% endif %}

{% endblock %}
{% block scripts %}

<script src="{{ url_for(
        'static',
        filename='js/recherche.js'
    ) }}" defer>
    </script>

<script src="{{ url_for(
        'static',
        filename='js/defilement.js'
    ) }}" defer>
    </script>

{% endblock %}