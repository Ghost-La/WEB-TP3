{% extends "base.jinja" %}
{% block title %}Modification{% endblock %}

{% block content %}

<h1 class="mb-4">Modifier la carte : {{ carte.nom }}</h1>

<form method="POST" novalidate="novalidate">

    <div class="mb-3">
        <label class="form-label">État</label>
        <select name="etat" class="form-select">
            <option {% if carte.etat == 'Presque neuve' %}selected{% endif %}>Presque neuve</option>
            <option {% if carte.etat == 'Légèrement usée' %}selected{% endif %}>Légèrement usée</option>
            <option {% if carte.etat == 'Modérément usée' %}selected{% endif %}>Modérément usée</option>
            <option {% if carte.etat == 'Très usée' %}selected{% endif %}>Très usée</option>
            <option {% if carte.etat == 'Abîmée' %}selected{% endif %}>Abîmée</option>
        </select>
        {% if erreurs.etat %}<div class="text-danger">{{ erreurs.etat }}</div>{% endif %}
    </div>

    <div class="mb-3">
        <label class="form-label">Coût</label>
        <input type="number" step="0.01" name="cout" class="form-control" value="{{ carte.cout }}">
        {% if erreurs.cout %}<div class="text-danger">{{ erreurs.cout }}</div>{% endif %}
    </div>

    <div class="mb-3">
        <label class="form-label">Statut</label>
        <select name="statut" class="form-select">
            <option {% if carte.statut == 1 %}selected{% endif %}>Disponible</option>
            <option {% if carte.statut == 0 %}selected{% endif %}>Recherchée</option>
        </select>
        {% if erreurs.statut %}<div class="text-danger">{{ erreurs.statut }}</div>{% endif %}
    </div>

    <button type="submit" class="btn btn-warning">Modifier</button>
    <a href="{{ url_for('collection.collection') }}" class="btn btn-secondary">Annuler</a>

</form>

{% endblock %}