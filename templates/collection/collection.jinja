{% extends "base.jinja" %}

{% block title %}Collection{% endblock %}

{% block content %}

<h1 class="mb-4 page-title">Collection de cartes</h1>
<div class="mb-4">

    <input type="search" id="recherche" class="form-control" placeholder="Rechercher une carte">

    <div id="suggestions" class="list-group mt-2">
    </div>

</div>

{% if cartes and cartes|length > 0 %}

<div class="row g-4">

    {% for carte in cartes %}

    <div class="col-12 col-md-6 col-lg-4 carte-item" {% if loop.index> 6 %}
        style="display:none;"
        {% endif %}>

        <div class="poke-card">

            <a href="{{ url_for('collection.detail', id_collection=carte.id_collection) }}">

                <div class="card-img-wrap">

                    {% if carte.photo %}

                    <img src="{{ url_for('static',filename='images/ajouts/' + carte.photo) }}" class="card-img-top"
                        alt="Carte Pokémon">

                    {% else %}

                    <img src="{{ url_for( 'static',filename='image/pikachu.jpg') }}" class="card-img-top"
                        alt="Carte Pokémon">

                    {% endif %}

                </div>

            </a>

            <div class="card-body">

                <h5 class="card-title">
                    {{ carte.nom }}
                </h5>

                <p class="card-text">

                    Type : {{ carte.supertype }}<br>

                    Rareté : {{ carte.rarete }}<br>

                    Coût : {{ carte.cout }} $<br>

                    {% if carte.statut == 1 %}
                    Statut : Disponible
                    {% else %}
                    Statut : Recherchée
                    {% endif %}

                </p>


                <div class="d-flex gap-2">

                    <a href="{{ url_for('collection.detail', id_collection=carte.id_collection) }}"
                        class="btn btn-primary btn-sm">
                        Détails

                    </a>

                    {% if "id" in session and (carte.id_collectionneur == session.id or session.get('role') == 'admin')
                    %}
                    <a href="{{ url_for('collection.modification', id_collection=carte.id_collection) }}"
                        class="btn btn-warning btn-sm">Modifier</a>
                    <a href="{{ url_for('collection.supprimer', id_collection=carte.id_collection) }}"
                        class="btn btn-danger btn-sm" onclick="return confirm('Supprimer cette carte ?');">Supprimer</a>
                    {% endif %}

                    {% if "id" in session and carte.id_collectionneur != session.id and carte.statut == 1 %}
                    <a href="{{ url_for('collection.faire_offre', id_collection=carte.id_collection) }}"
                        class="btn btn-success btn-sm">Faire une offre</a>
                    {% endif %}

                </div>

            </div>

        </div>

    </div>

    {% endfor %}

</div>

{% else %}

<div class="alert alert-info">

    <p>
        Aucune carte n’est présente dans votre collection pour le moment.
    </p>

</div>

{% endif %}

{% endblock %}
{% block scripts %}

<script src="{{ url_for(
        'static',
        filename='js/collection.js'
    ) }}" defer>
    </script>

<script src="{{ url_for(
        'static',
        filename='js/defilement.js'
    ) }}" defer>
    </script>

{% endblock %}